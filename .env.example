# Copia este fichero a .env (que no se publica) y rellénalo allí. Nunca pongas la clave aquí.
# Quién ejecuta (cable 1 de custodia). Sin esto no corre.
CUSTODIA_ACTOR=daniel
# Clave de OpenRouter. Tenerla no gasta nada: hace falta además JEV_MOTOR=openrouter.
OPENROUTER_API_KEY=
# Versión fijada de Jev.
JEV_MODEL=typesafe/jev-1.14
# Motor: simulado (por defecto, sin red) | seco (escribe las peticiones en data/peticiones/, sin red) | openrouter (gasta)
# JEV_MOTOR=simulado
# Tope de gasto acumulado en dólares entre todas las ejecuciones (suma el coste real del ledger).
# JEV_TOPE_USD=0.25
